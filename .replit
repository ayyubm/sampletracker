modules = ["nodejs-20", "python-3.11", "web"]
run = "NODE_ENV=development npm run dev"

[nix]
channel = "stable-24_05"
packages = ["google-cloud-sdk-gce"]

[deployment]
run = ["sh", "-c", "NODE_ENV=production npm run start"]
build = ["sh", "-c", "NODE_ENV=production npm run build"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001
